.read Edge(From, To) from "./inputs/edges.csv" as "csv".

Edge("a", "b").
Edge("b", "c").
Edge("c", "a").

.iterate {
    Reachable(x, y) :- Edge(x, y).
    Reachable(x, z) :- Reachable(x, y), Edge(y, z).
}

ReachCount(node, count(neighbor)) :- Reachable(node, neighbor).

.write ReachCount to "stdout" as "ReachCount: {:?}".